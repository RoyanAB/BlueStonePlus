{
    "multipart": [
        {   "when": { "facing": "up" },
            "apply": { "model": "dispenser_vertical" }
        },
        {   "when": { "facing": "down" },
            "apply": { "model": "dispenser_vertical", "x": 180 }
        },
        {   "when": { "facing": "north" },
            "apply": { "model": "dispenser" }
        },
        {   "when": { "facing": "south" },
            "apply": { "model": "dispenser", "y": 180 }
        },
        {   "when": { "facing": "east" },
            "apply": { "model": "dispenser", "y": 90 }
        },
        {   "when": { "facing": "west" },
            "apply": { "model": "dispenser", "y": 270 }
        },
        {   "when": { "facing": "up", "triggered": "false" },
            "apply": { "model": "dispenser_vertical" }
        },
        {   "when": { "facing": "down", "triggered": "false" },
            "apply": { "model": "dispenser_vertical", "x": 180 }
        },
        {   "when": { "facing": "north", "triggered": "false" },
            "apply": { "model": "dispenser" }
        },
        {   "when": { "facing": "south", "triggered": "false" },
            "apply": { "model": "dispenser", "y": 180 }
        },
        {   "when": { "facing": "east", "triggered": "false" },
            "apply": { "model": "dispenser", "y": 90 }
        },
        {   "when": { "facing": "west", "triggered": "false" },
            "apply": { "model": "dispenser", "y": 270 }
        },
        {   "when": { "facing": "up", "triggered": "true" },
            "apply": { "model": "dispenser_vertical_on" }
        },
        {   "when": { "facing": "down", "triggered": "true" },
            "apply": { "model": "dispenser_vertical_on", "x": 180 }
        },
        {   "when": { "facing": "north", "triggered": "true" },
            "apply": { "model": "dispenser_on" }
        },
        {   "when": { "facing": "south", "triggered": "true" },
            "apply": { "model": "dispenser_on", "y": 180 }
        },
        {   "when": { "facing": "east", "triggered": "true" },
            "apply": { "model": "dispenser_on", "y": 90 }
        },
        {   "when": { "facing": "west", "triggered": "true" },
            "apply": { "model": "dispenser_on", "y": 270 }
        }
    ]
}