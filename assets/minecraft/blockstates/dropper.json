{
    "multipart": [
        {   "when": { "facing": "up" },
            "apply": { "model": "dropper_vertical" }
        },
        {   "when": { "facing": "down" },
            "apply": { "model": "dropper_vertical", "x": 180 }
        },
        {   "when": { "facing": "north" },
            "apply": { "model": "dropper" }
        },
        {   "when": { "facing": "south" },
            "apply": { "model": "dropper", "y": 180 }
        },
        {   "when": { "facing": "east" },
            "apply": { "model": "dropper", "y": 90 }
        },
        {   "when": { "facing": "west" },
            "apply": { "model": "dropper", "y": 270 }
        },
        {   "when": { "facing": "up", "triggered": "false" },
            "apply": { "model": "dropper_vertical" }
        },
        {   "when": { "facing": "down", "triggered": "false" },
            "apply": { "model": "dropper_vertical", "x": 180 }
        },
        {   "when": { "facing": "north", "triggered": "false" },
            "apply": { "model": "dropper" }
        },
        {   "when": { "facing": "south", "triggered": "false" },
            "apply": { "model": "dropper", "y": 180 }
        },
        {   "when": { "facing": "east", "triggered": "false" },
            "apply": { "model": "dropper", "y": 90 }
        },
        {   "when": { "facing": "west", "triggered": "false" },
            "apply": { "model": "dropper", "y": 270 }
        },
        {   "when": { "facing": "up", "triggered": "true" },
            "apply": { "model": "dropper_vertical_on" }
        },
        {   "when": { "facing": "down", "triggered": "true" },
            "apply": { "model": "dropper_vertical_on", "x": 180 }
        },
        {   "when": { "facing": "north", "triggered": "true" },
            "apply": { "model": "dropper_on" }
        },
        {   "when": { "facing": "south", "triggered": "true" },
            "apply": { "model": "dropper_on", "y": 180 }
        },
        {   "when": { "facing": "east", "triggered": "true" },
            "apply": { "model": "dropper_on", "y": 90 }
        },
        {   "when": { "facing": "west", "triggered": "true" },
            "apply": { "model": "dropper_on", "y": 270 }
        }
    ]
}